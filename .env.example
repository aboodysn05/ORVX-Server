PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/orvx

# Generate your own with: openssl rand -hex 32 — never reuse this example value.
JWT_SECRET=replace_with_a_random_string
JWT_EXPIRES_IN=7d

# One-off account seeds — used by `npm run seed:admin` / `npm run seed:evaluator`.
# Not read by the server. Passwords must be at least 8 characters.
ADMIN_NAME=ORVX Admin
ADMIN_EMAIL=admin@orvx.local
ADMIN_PASSWORD=change_me_please
EVALUATOR_NAME=Coach #9
EVALUATOR_EMAIL=evaluator@orvx.local
EVALUATOR_PASSWORD=change_me_please
