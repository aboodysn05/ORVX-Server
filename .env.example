# 5000 conflicts with macOS's AirPlay Receiver (System Settings > General >
# AirDrop & Handoff) on most Macs — use 5001 instead, or turn AirPlay
# Receiver off if you want 5000.
PORT=5001
DATABASE_URL=postgresql://user:password@localhost:5432/orvx

# Generate your own with: openssl rand -hex 32 — never reuse this example value.
JWT_SECRET=replace_with_a_random_string
JWT_EXPIRES_IN=7d
